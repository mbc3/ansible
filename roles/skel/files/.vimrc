"Enable filetype plugins
filetype plugin indent on

"Set to auto read when a file is changed from the outside
set autoread

"Show the command line
set showcmd
set cmdheight=2

"Turn on the Wild menu
set wildmenu

"lazy redraw (edge case for macros, improves performance)
set lazyredraw

"Backspace that works more like other word processors
set backspace=eol,start,indent

"Ignore case when searching
set ignorecase

"When searching try to be smart about cases
set smartcase

"search characters as they are entered (search with /)
set incsearch

"Enable syntax highlighting
syntax enable

"tabs are just 8 spaces
set tabstop=8
set shiftwidth=4
set softtabstop=4
set expandtab
set smarttab
set shiftround
set scrolloff=5
set sidescrolloff=5
set linebreak
set ruler

"Indents
set autoindent
set smartindent
set wrap

"see the line number
set number

"enable the mouse
set mouse=a

set showmatch
